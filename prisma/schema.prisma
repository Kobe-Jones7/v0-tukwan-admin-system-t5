// schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ENUMS

enum ItineraryTimelineType {
  road
  tour
  time
  food
}

enum UserStatus {
  active
  inactive
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum BookingItemType {
  ATTRACTION
  PACKAGE
}

enum PurchaseStatus {
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  PAYSTACK
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  FAILED
  PAID
  PENDING
}

// TYPES

type Location {
  address      String
  country      String
  country_code String
  city         String
  longitude    Float
  latitude     Float
  region       String
}

type VisitingInformation {
  opening_hours String
  entry_fee     String
}

type ItineraryTimeline {
  description String
  time        String
  title       String
  type        ItineraryTimelineType
}

type ItineraryItem {
  accommodation  String
  categories     String[]
  description    String
  images         String[]
  included_meals String[]
  name           String
  timeline       ItineraryTimeline[]
  travel_tips    String[]
}

type BookingItem {
  id   String          @db.ObjectId
  type BookingItemType
}

// MODELS

model User {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  avatar     String
  email      String     @unique
  first_name String
  last_name  String
  phone      String
  status     UserStatus
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Attractions {
  id                    String              @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  slug                  String              @unique
  category              String
  overview              String
  history               String
  cultural_significance String
  images                String[]
  location              Location
  visitingInformation   VisitingInformation
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model Marketplace {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  slug           String   @unique
  category       String
  price          Float
  quantity       Int
  images         String[]
  features       String[]
  specifications Json
  description    String
  about_product  String
  vendor         Vendor?  @relation(fields: [vendorId], references: [id])
  vendorId       String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Vendor {
  id       String        @id @default(auto()) @map("_id") @db.ObjectId
  name     String        @unique
  products Marketplace[]
}

model TourPackages {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  slug               String          @unique
  region             String
  duration           Int
  group_size         Int
  description        String
  minimum_age        Int
  best_time          String
  tour_highlights    String[]
  what_to_bring      String[]
  price              Float
  images             String[]
  whats_included     String[]
  whats_not_included String[]
  // cancellation_policy String?
  itinerary          ItineraryItem[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Booking {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  items          BookingItem[]
  customer_name  String
  customer_email String
  customer_phone String
  tour_date      DateTime
  amount         Float
  status         BookingStatus @default(pending)
  payment        Payment?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

/// New model for marketplace purchases
model MarketplacePurchase {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  itemIds        String[]       @db.ObjectId
  customer_name  String
  customer_email String
  customer_phone String
  purchase_date  DateTime       @default(now())
  amount         Float
  status         PurchaseStatus @default(CONFIRMED)
  payment        Payment?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Payment {
  id           String               @id @default(auto()) @map("_id") @db.ObjectId
  provider     PaymentProvider      @default(PAYSTACK)
  checkout_url String
  access_code  String
  reference    String
  status       PaymentStatus        @default(PENDING)
  order_id     String?              @unique @db.ObjectId
  // polymorphic one-to-one:
  // if this payment is for a booking, relates to Booking.id
  order        Booking?             @relation(fields: [order_id], references: [id])
  // if for a marketplace purchase, same order_id links here
  purchase     MarketplacePurchase? @relation(fields: [order_id], references: [id])
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}
